# Docker build context — application sources only; no checkpoint or private runtime artifacts.
# .gitignore KHÔNG ảnh hưởng docker; phải khai báo riêng ở đây.

# Môi trường ảo (cài lại trong image)
.venv/
**/.venv/
venv/
**/node_modules/
backend/.tmp/
backend/bin/
**/*.tsbuildinfo
client/.next/
cms/dist/
playwright-report/
test-results/

# Dataset thô — inference KHÔNG cần, rất nặng
data/
dist/kaggle/

# Log train
ai-core/checkpoints/
runs/
ai-core/runs/

# Python cache + test
__pycache__/
*.py[cod]
**/.pytest_cache/
ai-core/ai_core/tests/
inference-service/tests/

# Git + docs + design (không cần trong image runtime)
.git/
.gitignore
docs/
stitch_ai_video_cms/
stitch_ai_video_platform_vietnamese/
my-agent/
.claude/
coordination/
.agents/

# Secrets (đặt qua -e / env server, không bake vào image)
**/.env
**/.env.*
!**/.env.example

# Claude owns checkpoint/runtime management outside this build context.
