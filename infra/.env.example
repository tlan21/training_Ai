# infra/.env — copy thành infra/.env (đã gitignore). Dùng: docker compose --env-file infra/.env ...

# PostgreSQL
POSTGRES_USER=app
POSTGRES_PASSWORD=app_pw
POSTGRES_DB=video_ai

# MongoDB
MONGO_USER=app
MONGO_PASSWORD=app_pw
MONGO_DB=video_ai

# MinIO (đổi ở production)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
