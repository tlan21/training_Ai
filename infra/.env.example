# Copy: cp infra/.env.example infra/.env  (Linux/macOS)
#       copy infra\.env.example infra\.env  (Windows CMD)
#       Copy-Item infra/.env.example infra/.env  (PowerShell)
# Dùng: docker compose --env-file infra/.env -f infra/docker-compose.yml up -d
# Sau đó sửa các giá trị _change_me. File infra/.env đã gitignore.

# PostgreSQL (app DB)
POSTGRES_USER=app
POSTGRES_PASSWORD=app_pw_change_me
POSTGRES_DB=video_ai

# MongoDB
MONGO_USER=app
MONGO_PASSWORD=app_pw_change_me
MONGO_DB=video_ai

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_change_me
