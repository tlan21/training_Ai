            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "gpu_vram_used": {
            "type": "number",
            "title": "Gpu Vram Used"
          },
          "gpu_util": {
            "type": "number",
            "title": "Gpu Util"
          },
          "models_loaded": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Models Loaded"
          },
          "degraded": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Degraded"
          },
          "dependencies": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Dependencies",
            "default": {}
          },
          "queue_depth": {
            "type": "integer",
            "title": "Queue Depth"
          },
          "device": {
            "type": "string",
            "title": "Device"
          },
          "stub_mode": {
            "type": "boolean",
            "title": "Stub Mode"
