  "components": {
    "schemas": {
      "ASRRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "primitive-asr-transformer"
          },
          "audio_url": {
            "type": "string",
            "title": "Audio Url"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "vi"
          }
        },
        "type": "object",
        "required": [
          "audio_url"
        ],
        "title": "ASRRequest"
      },
      "ASRResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "object": {
            "type": "string",
            "title": "Object",
            "default": "asr_completion"
          },
          "created": {
            "type": "integer",
            "title": "Created"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "full_transcript": {
            "type": "string",
            "title": "Full Transcript"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/ASRSegment"
            },
            "type": "array",
            "title": "Segments"
          }
        },
        "type": "object",
        "required": [
          "id",
          "created",
          "model",
          "full_transcript",
          "segments"
        ],
        "title": "ASRResponse"
      },
      "ASRSegment": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "start_time": {
            "type": "number",
            "title": "Start Time"
          },
          "end_time": {
            "type": "number",
            "title": "End Time"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence",
            "default": 1.0
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warning"
          }
        },
        "type": "object",
        "required": [
          "id",
          "start_time",
          "end_time",
          "text"
        ],
        "title": "ASRSegment"
      },
      "CompletionChoice": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "index": {
            "type": "integer",
            "title": "Index",
            "default": 0
          },
          "logprobs": {
            "type": "null",
            "title": "Logprobs"
          },
          "finish_reason": {
            "type": "string",
            "title": "Finish Reason",
            "default": "stop"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "CompletionChoice"
      },
      "CompletionRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "primitive-gpt-summarizer"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Max Tokens",
            "default": 150
          },
          "temperature": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Temperature",
            "default": 0.7
          },
          "top_p": {
            "type": "number",
            "title": "Top P",
            "default": 0.9
          },
          "frequency_penalty": {
            "type": "number",
            "title": "Frequency Penalty",
            "default": 0.0
          },
          "presence_penalty": {
            "type": "number",
            "title": "Presence Penalty",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "CompletionRequest"
      },
      "CompletionResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "object": {
            "type": "string",
            "title": "Object",
            "default": "text_completion"
          },
          "created": {
            "type": "integer",
            "title": "Created"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "choices": {
            "items": {
              "$ref": "#/components/schemas/CompletionChoice"
            },
            "type": "array",
            "title": "Choices"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "type": "object",
        "required": [
          "id",
          "created",
          "model",
          "choices",
          "usage"
