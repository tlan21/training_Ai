          "recommended_clips": {
            "items": {
              "$ref": "#/components/schemas/RecommendedClip"
            },
            "type": "array",
            "title": "Recommended Clips"
          }
        },
        "type": "object",
        "required": [
          "id",
          "created",
          "model",
          "video_id",
          "timeline_scores",
          "recommended_clips"
        ],
        "title": "HighlightResponse"
      },
      "Recommendation": {
        "properties": {
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "thumbnail_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thumbnail Url"
          }
        },
        "type": "object",
        "required": [
          "video_id",
          "score"
