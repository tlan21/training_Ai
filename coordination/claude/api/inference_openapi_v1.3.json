            "default": "highlight_completion"
          },
          "created": {
            "type": "integer",
            "title": "Created"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "timeline_scores": {
            "items": {
              "$ref": "#/components/schemas/TimelineScore"
