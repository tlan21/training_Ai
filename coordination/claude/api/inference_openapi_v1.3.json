        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "primitive-two-tower-recommender"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "limit": {
            "type": "integer",
            "title": "Limit",
            "default": 10
