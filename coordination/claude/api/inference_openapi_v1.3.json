          },
          "start_time": {
            "type": "number",
            "title": "Start Time"
          },
          "end_time": {
            "type": "number",
            "title": "End Time"
          },
          "average_score": {
            "type": "number",
            "title": "Average Score"
          }
        },
        "type": "object",
        "required": [
          "clip_id",
          "start_time",
          "end_time",
          "average_score"
        ],
        "title": "RecommendedClip"
      },
      "SearchRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "primitive-siamese-vit"
          },
          "image": {
            "type": "string",
            "title": "Image",
            "description": "data URI base64 hoặc path"
          },
          "top_k": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 5
          },
          "threshold": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Threshold",
            "default": 0.75
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "SearchRequest"
      },
      "SearchResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "object": {
            "type": "string",
            "title": "Object",
            "default": "search_completion"
          },
          "created": {
            "type": "integer",
            "title": "Created"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
