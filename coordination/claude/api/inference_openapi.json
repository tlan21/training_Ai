  "components": {
    "schemas": {
      "ASRResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "object": {
            "type": "string",
            "title": "Object",
            "default": "asr_completion"
          },
          "created": {
            "type": "integer",
            "title": "Created"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "full_transcript": {
            "type": "string",
            "title": "Full Transcript"
          },
          "segments": {
            "items": {
              "$ref": "#/components/schemas/ASRSegment"
            },
            "type": "array",
            "title": "Segments"
          }
        },
        "type": "object",
        "required": [
          "id",
          "created",
          "model",
          "full_transcript",
          "segments"
        ],
        "title": "ASRResponse"
      },
      "ASRSegment": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "start_time": {
            "type": "number",
            "title": "Start Time"
          },
          "end_time": {
            "type": "number",
            "title": "End Time"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence",
            "default": 1.0
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warning"
          }
        },
        "type": "object",
        "required": [
          "id",
          "start_time",
          "end_time",
          "text"
        ],
        "title": "ASRSegment"
      },
      "Body_asr_v2_asr_completions_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "WAV/FLAC/OGG; khuyến nghị 16 kHz mono PCM16"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "vi"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": "primitive-asr-transformer"
          },
          "offset_seconds": {
            "type": "number",
            "minimum": 0.0,
            "title": "Offset Seconds",
            "description": "cộng vào mọi timestamp khi backend chia file dài",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_asr_v2_asr_completions_post"
      },
      "CompletionChoice": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "index": {
            "type": "integer",
            "title": "Index",
            "default": 0
          },
          "logprobs": {
            "type": "null",
            "title": "Logprobs"
          },
          "finish_reason": {
            "type": "string",
            "title": "Finish Reason",
            "default": "stop"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "CompletionChoice"
      },
      "CompletionRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "primitive-gpt-summarizer"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Max Tokens",
            "default": 150
          },
          "temperature": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Temperature",
            "default": 0.7
          },
          "top_p": {
            "type": "number",
            "title": "Top P",
            "default": 0.9
          },
          "frequency_penalty": {
            "type": "number",
            "title": "Frequency Penalty",
            "default": 0.0
          },
          "presence_penalty": {
            "type": "number",
            "title": "Presence Penalty",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "CompletionRequest"
      },
      "CompletionResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "object": {
            "type": "string",
            "title": "Object",
            "default": "text_completion"
          },
          "created": {
            "type": "integer",
            "title": "Created"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "choices": {
            "items": {
              "$ref": "#/components/schemas/CompletionChoice"
            },
            "type": "array",
            "title": "Choices"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          }
        },
        "type": "object",
        "required": [
          "id",
          "created",
          "model",
          "choices",
          "usage"
        ],
        "title": "CompletionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "gpu_vram_used": {
            "type": "number",
            "title": "Gpu Vram Used"
          },
          "gpu_util": {
            "type": "number",
            "title": "Gpu Util"
          },
          "models_loaded": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Models Loaded"
          },
          "degraded": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Degraded"
          },
          "dependencies": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Dependencies",
            "default": {}
          },
          "queue_depth": {
            "type": "integer",
            "title": "Queue Depth"
          },
          "device": {
            "type": "string",
            "title": "Device"
          },
          "stub_mode": {
            "type": "boolean",
            "title": "Stub Mode"
          },
          "load_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Load Error"
          }
        },
        "type": "object",
        "required": [
          "status",
          "gpu_vram_used",
          "gpu_util",
          "models_loaded",
          "degraded",
          "queue_depth",
          "device",
          "stub_mode"
        ],
        "title": "HealthResponse"
      },
      "HighlightFeatures": {
        "properties": {
          "vision_embeddings": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Vision Embeddings"
          },
          "audio_spectrogram_features": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Audio Spectrogram Features"
          }
        },
        "type": "object",
        "required": [
          "vision_embeddings",
          "audio_spectrogram_features"
        ],
        "title": "HighlightFeatures"
      },
      "HighlightRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "primitive-seq2seq-highlighter"
          },
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "features": {
            "$ref": "#/components/schemas/HighlightFeatures"
          },
          "asr_segments": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/SpeechSpan"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asr Segments"
          }
        },
        "type": "object",
        "required": [
          "video_id",
          "features"
        ],
        "title": "HighlightRequest"
      },
      "HighlightResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "object": {
            "type": "string",
            "title": "Object",
            "default": "highlight_completion"
          },
          "created": {
            "type": "integer",
            "title": "Created"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "timeline_scores": {
            "items": {
              "$ref": "#/components/schemas/TimelineScore"
            },
            "type": "array",
            "title": "Timeline Scores"
          },
          "recommended_clips": {
            "items": {
              "$ref": "#/components/schemas/RecommendedClip"
            },
            "type": "array",
            "title": "Recommended Clips"
          },
          "clip_threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clip Threshold"
          }
        },
        "type": "object",
        "required": [
          "id",
          "created",
          "model",
          "video_id",
          "timeline_scores",
          "recommended_clips"
        ],
        "title": "HighlightResponse"
      },
      "RecoEmbeddingRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "primitive-two-tower-recommender"
          },
          "videos": {
            "items": {
              "$ref": "#/components/schemas/RecoVideoFeatures"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Videos"
          },
          "users": {
            "items": {
              "$ref": "#/components/schemas/RecoUserFeatures"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Users"
          }
        },
        "type": "object",
        "title": "RecoEmbeddingRequest"
      },
      "RecoEmbeddingResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "object": {
            "type": "string",
            "title": "Object",
            "default": "recommendation_embeddings"
          },
          "created": {
            "type": "integer",
            "title": "Created"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "feature_version": {
            "type": "string",
            "title": "Feature Version",
            "default": "ttv2-features-v1"
          },
          "dim": {
            "type": "integer",
            "title": "Dim",
            "default": 128
          },
          "metric": {
            "type": "string",
            "title": "Metric",
            "default": "IP"
          },
          "normalized": {
            "type": "boolean",
            "title": "Normalized",
            "default": true
          },
          "videos": {
            "items": {
              "$ref": "#/components/schemas/VideoVector"
            },
            "type": "array",
            "title": "Videos"
          },
          "users": {
            "items": {
              "$ref": "#/components/schemas/UserVector"
            },
            "type": "array",
            "title": "Users"
          }
        },
        "type": "object",
        "required": [
          "id",
          "created",
          "model",
          "videos",
          "users"
        ],
        "title": "RecoEmbeddingResponse"
      },
      "RecoUserFeatures": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "preferred_category_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Preferred Category Ids"
          },
          "positive_video_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Positive Video Ids",
            "description": "mỗi id phải có trong `videos` của cùng request"
          }
        },
        "type": "object",
        "required": [
          "user_id"
        ],
        "title": "RecoUserFeatures"
      },
      "RecoVideoFeatures": {
        "properties": {
          "video_id": {
            "type": "string",
            "title": "Video Id"
          },
          "category_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category Id"
          },
          "content_embedding_256": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array",
                "maxItems": 256,
                "minItems": 256
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Embedding 256"
          },
          "positive_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Positive Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "video_id"
        ],
        "title": "RecoVideoFeatures"
      },
      "RecommendedClip": {
        "properties": {
          "clip_id": {
            "type": "string",
            "title": "Clip Id"
          },
          "start_time": {
            "type": "number",
            "title": "Start Time"
          },
          "end_time": {
            "type": "number",
            "title": "End Time"
          },
          "average_score": {
            "type": "number",
            "title": "Average Score"
          }
        },
        "type": "object",
        "required": [
          "clip_id",
          "start_time",
          "end_time",
          "average_score"
        ],
        "title": "RecommendedClip"
      },
      "SearchEmbeddingRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "primitive-siamese-vit"
          },
          "image": {
            "type": "string",
            "title": "Image",
            "description": "data URI hoặc base64 JPEG/PNG/WebP (≤20 MP); không nhận path"
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "SearchEmbeddingRequest"
      },
      "SearchEmbeddingResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "object": {
            "type": "string",
            "title": "Object",
            "default": "search_embedding"
          },
          "created": {
            "type": "integer",
            "title": "Created"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "vector": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Vector"
          },
          "dim": {
            "type": "integer",
            "title": "Dim",
            "default": 128
          },
          "metric": {
            "type": "string",
            "title": "Metric",
            "default": "COSINE"
          },
          "normalized": {
            "type": "boolean",
            "title": "Normalized",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "created",
          "model",
          "vector"
        ],
        "title": "SearchEmbeddingResponse"
      },
      "SpeechSpan": {
        "properties": {
          "start_time": {
            "type": "number",
            "title": "Start Time"
          },
          "end_time": {
            "type": "number",
            "title": "End Time"
          }
        },
        "type": "object",
        "required": [
          "start_time",
          "end_time"
        ],
        "title": "SpeechSpan"
      },
      "TimelineScore": {
        "properties": {
          "second": {
            "type": "integer",
            "title": "Second"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "second",
