# inference-service — copy thành .env rồi chỉnh. .env KHÔNG commit (đã có trong .gitignore).

# Bearer key nội bộ gateway↔inference-service. Format sk-local-... (tự sinh, KHÔNG phải OpenAI).
# Sinh key mới: python -m app.gen_key   (hoặc xem README)
AI_SERVICE_KEY=sk-local-CHANGE-ME

# Thư mục checkpoint 6 model từ ai-core. Thiếu best.pt → endpoint chạy STUB.
CHECKPOINT_DIR=../ai-core/checkpoints

# auto | cpu | cuda. auto = cuda nếu có, không thì cpu.
INFER_DEVICE=auto

# 1 = ép STUB kể cả khi có checkpoint (dev/test không GPU). 0 = dùng model thật nếu có.
FORCE_STUB=0

# ---- Milvus cho /v1/recommendation (T1.7d) ----
# Collection do infra/milvus/init_collections.py tạo: dim 128, index IVF_FLAT, metric IP
# (database_schema §4). Nạp vector Two-Tower vào bằng:
#   python -m ai_core.scripts.export_two_tower_milvus --checkpoint <two_tower/best.pt> ...
# Không kết nối được → endpoint recommendation rơi về STUB, service KHÔNG sập.
# Chạy trong mạng docker thì MILVUS_HOST là `milvus` thay vì localhost.
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_RECO_COLLECTION=user_recommendation_embeddings
