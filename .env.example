# Copy:  cp .env.example .env              (Linux/macOS)
#        copy .env.example .env             (Windows CMD)
#        Copy-Item .env.example .env        (PowerShell)
# Sau đó sửa các giá trị _change_me. File .env đã gitignore, không commit.

# ── Infra (docker-compose: postgres/mongo/minio/milvus/kafka/redis) ──
# Dùng cho: docker compose --env-file infra/.env -f infra/docker-compose.yml up -d
# Lưu ý: infra/.env là file riêng (copy .env.example -> infra/.env hoặc copy infra/.env.example -> infra/.env)
POSTGRES_USER=app
POSTGRES_PASSWORD=123456
POSTGRES_DB=video_ai
MONGO_USER=app
MONGO_PASSWORD=123456
MONGO_DB=video_ai
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=12345678
REDIS_PASSWORD=123456

# ── Backend Gateway + Workers (backend/internal/config) ──
GATEWAY_PORT=8000
JWT_SECRET=change-me-32-random-chars__openssl-rand-hex-32
AI_SERVICE_KEY=sk-local-dev-key-change-me
AI_BASE_URL=http://localhost:8001

# DSN phải khớp POSTGRES_USER/PASSWORD/DB ở trên
POSTGRES_DSN=postgres://app:123456@localhost:5432/video_ai?sslmode=disable
MONGO_URI=mongodb://app:123456@localhost:27017
MILVUS_HOST=localhost
MILVUS_PORT=19530
KAFKA_BROKERS=localhost:9092
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=12345678
MINIO_BUCKET=raw-videos
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=123456

# ── Inference Service (inference-service/app/config.py) ──
# Dùng chung AI_SERVICE_KEY với gateway
CHECKPOINT_DIR=../ai-core/checkpoints
INFER_DEVICE=auto
FORCE_STUB=0
MILVUS_RECO_COLLECTION=user_recommendation_embeddings
